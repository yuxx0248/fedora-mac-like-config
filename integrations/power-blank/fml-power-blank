#!/usr/bin/env python3
# managed by fedora-mac-like-config (integrations/power-blank/fml-power-blank)
"""Power button short press -> screen blank (no suspend, no lock).

Listens on the platform power-key evdev device (pmic_pwrkey on the validated
ASUS Zenbook A16) and calls org.gnome.ScreenSaver.SetActive(true) on press,
which blanks the screen while background processes, cron jobs and user-space
timers keep running. Waking is by any mouse/keyboard activity.

Pair with:
  - GNOME: org.gnome.settings-daemon.plugins.power power-button-action='nothing'
    (installed via the toolkit module `power-nothing`)
  - logind (optional, scripts/power-blank.sh logind): HandlePowerKey=ignore so
    logind does not power off, and HandlePowerKeyLongPress=suspend.

Requires python3 stdlib only. Runs as the logged-in desktop user via the
fml-power-blank.service user unit.
"""
from __future__ import annotations

import glob
import os
import struct
import subprocess
import sys
import time

EV_KEY = 0x01
KEY_POWER = 116

BLANK_CMD = [
    "gdbus", "call", "--session",
    "--dest", "org.gnome.ScreenSaver",
    "--object-path", "/org/gnome/ScreenSaver",
    "--method", "org.gnome.ScreenSaver.SetActive", "true",
]

# struct input_event on 64-bit Linux: two i64 timeval fields, u16 type, u16 code, i32 value
EVENT_FMT = "llHHI"
EVENT_SIZE = struct.calcsize(EVENT_FMT)


def find_pwrkey_event() -> str | None:
    """Return the evdev node of the platform power key, if reachable."""
    for name_path in glob.glob("/sys/class/input/input*/name"):
        try:
            if open(name_path).read().strip() != "pmic_pwrkey":
                continue
            input_dir = os.path.dirname(name_path)
            for ev in glob.glob(os.path.join(input_dir, "event*")):
                if os.path.isdir(ev):
                    return "/dev/input/" + os.path.basename(ev)
        except OSError:
            continue
    return None


def main() -> None:
    event_node = find_pwrkey_event()
    if not event_node:
        # Leave cleanly so the user unit does not restart-loop on hardware
        # without a pmic_pwrkey device (screen blank simply stays unmanaged).
        print("fml-power-blank: no pmic_pwrkey evdev device found; nothing to watch.", file=sys.stderr)
        return
    fd = os.open(event_node, os.O_RDONLY)
    last_blank = 0.0
    while True:
        data = os.read(fd, EVENT_SIZE)
        if len(data) != EVENT_SIZE:
            continue
        _, _, etype, code, value = struct.unpack(EVENT_FMT, data)
        if etype == EV_KEY and code == KEY_POWER and value == 1:
            now = time.monotonic()
            if now - last_blank > 0.5:  # debounce double reports
                last_blank = now
                try:
                    subprocess.run(BLANK_CMD, check=False,
                                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                except OSError:
                    pass


if __name__ == "__main__":
    main()
